{
  "name": "@reviewrouter/protocol-review-action-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./conversation": {
      "types": "./src/conversation.ts",
      "production": "./dist/conversation.js",
      "default": "./src/conversation.ts"
    },
    "./usage-responses-v1": {
      "types": "./src/generated/usage-responses-v1.ts",
      "production": "./dist/generated/usage-responses-v1.js",
      "default": "./src/generated/usage-responses-v1.ts"
    },
    "./usage-producer-v1": {
      "types": "./src/generated/usage-producer-v1.ts",
      "production": "./dist/generated/usage-producer-v1.js",
      "default": "./src/generated/usage-producer-v1.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/protocol-review-action-v2/src/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
