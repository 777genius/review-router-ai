{
  "name": "@reviewrouter/features-review-history",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./src/domain/history.ts",
      "production": "./dist/domain/history.js",
      "default": "./src/domain/history.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "production": "./dist/composition/index.js",
      "default": "./src/composition/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "production": "./dist/testing/index.js",
      "default": "./src/testing/index.ts"
    }
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "@get-modular/core": "0.7.0",
    "@get-modular/assembly": "0.7.0"
  },
  "devDependencies": {
    "@get-modular/conformance": "0.5.0",
    "@get-modular/resources": "0.2.1",
    "vitest": "4.1.10",
    "pg": "8.23.0",
    "@prisma/adapter-pg": "7.8.0",
    "@reviewrouter/features-review-executions": "workspace:*",
    "@reviewrouter/features-review-processes": "workspace:*"
  },
  "scripts": {
    "build": "node ../../../scripts/local-checks/compiler-cli.ts --native -p tsconfig.build.json",
    "typecheck": "node ../../../scripts/local-checks/compiler-cli.ts --native --noEmit -p tsconfig.json"
  }
}
