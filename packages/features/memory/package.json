{
  "name": "@reviewrouter/features-memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./infrastructure": {
      "types": "./src/infrastructure/index.ts",
      "production": "./dist/infrastructure/index.js",
      "default": "./src/infrastructure/index.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "production": "./dist/composition/index.js",
      "default": "./src/composition/index.ts"
    }
  },
  "dependencies": {
    "@get-modular/core": "0.7.0",
    "@get-modular/assembly": "0.7.0",
    "@vectorize-io/hindsight-client": "https://github.com/vectorize-io/hindsight/releases/download/v1.1.0/vectorize-io-hindsight-client-1.1.0.tgz",
    "@prisma/client": "^7.8.0",
    "@reviewrouter/features-entitlements": "workspace:*",
    "@reviewrouter/features-outbox": "workspace:*",
    "@reviewrouter/shared": "workspace:*"
  },
  "scripts": {
    "build": "node ../../../scripts/local-checks/compiler-cli.ts --native -p tsconfig.build.json",
    "typecheck": "node ../../../scripts/local-checks/compiler-cli.ts --native --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "vitest": "4.1.10",
    "@reviewrouter/platform-db": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "pg": "8.23.0",
    "@types/pg": "8.23.1"
  }
}
