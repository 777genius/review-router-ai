{
  "name": "@reviewrouter/features-memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./outbox": {
      "types": "./src/infrastructure/outbox/memory-index-outbox-handlers.ts",
      "production": "./dist/infrastructure/outbox/memory-index-outbox-handlers.js",
      "default": "./src/infrastructure/outbox/memory-index-outbox-handlers.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "production": "./dist/composition/index.js",
      "default": "./src/composition/index.ts"
    }
  },
  "dependencies": {
    "@get-modular/core": "0.2.0",
    "@get-modular/assembly": "0.2.0",
    "@infinity-context/sdk": "https://github.com/777genius/infinity-context/releases/download/sdk-v0.2.4/infinity-context-sdk-0.2.4.tgz",
    "@prisma/client": "^7.8.0",
    "@reviewrouter/features-entitlements": "workspace:*",
    "@reviewrouter/features-outbox": "workspace:*",
    "@reviewrouter/shared": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "vitest": "4.1.10",
    "@reviewrouter/platform-db": "workspace:*"
  }
}
