{
  "name": "@reviewrouter/platform-signed-capabilities",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "production": "./dist/testing/index.js",
      "default": "./src/testing/index.ts"
    }
  },
  "dependencies": {
    "jose": "^6.2.4"
  },
  "scripts": {
    "build": "node ../../../scripts/local-checks/compiler-cli.ts --native -p tsconfig.build.json",
    "test": "vitest run --root ../../.. src/signed-capability.test.ts",
    "typecheck": "node ../../../scripts/local-checks/compiler-cli.ts --native --noEmit -p tsconfig.json"
  }
