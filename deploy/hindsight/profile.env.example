# API and worker use the SAME qualified immutable derivative image.
# API is private; no browser, customer Action or public direct-user ingress.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:REPLACE@private-postgres:5432/hindsight?application_name=REPLACE_PROCESS_GENERATION
HINDSIGHT_API_DATABASE_SCHEMA=public
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=REPLACE_SERVER_SIDE_SERVICE_KEY
HINDSIGHT_API_WORKER_ID=REPLACE_UNIQUE_EXECUTOR_GENERATION
HINDSIGHT_API_WORKER_ENABLED=false
HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=false
# Preserve native UUID replay authority. 0 disables pruning; it is not immediate expiry.
HINDSIGHT_API_OPERATION_RETENTION_DAYS=0
HINDSIGHT_API_OPERATION_CLEANUP_INTERVAL_SECONDS=0
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=native
HINDSIGHT_API_LLM_TRACE_ENABLED=false
HINDSIGHT_API_OTEL_TRACES_ENABLED=false
HINDSIGHT_API_AUDIT_LOG_ENABLED=false
HINDSIGHT_API_LLM_DEBUG_DUMP_4XX=false
HINDSIGHT_API_XAI_OAUTH_DEBUG_HEADERS=false
HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_API_ENABLE_FILE_UPLOAD_API=false
HINDSIGHT_API_ACCESS_LOG=false
HINDSIGHT_API_FAIL_ON_EXTRACTION_ERRORS=true
# Approved statement text is deliberately provider-owned and editable there.
HINDSIGHT_API_STORE_DOCUMENT_TEXT=true
# Model/embedding/reranker egress is a separate release decision. Set provider,
# model, dimensions, endpoint and dedicated credentials explicitly; no defaults
# here authorize inference with customer review credentials.
# Physical-forget cleanup API ONLY: all five zero cadences plus API worker off.
# HINDSIGHT_API_CONSOLIDATION_RECONCILE_INTERVAL_SECONDS=0
# HINDSIGHT_API_MENTAL_MODEL_REFRESH_TICK_SECONDS=0
# HINDSIGHT_API_RETENTION_SWEEP_INTERVAL_SECONDS=0
# HINDSIGHT_API_OPERATION_CLEANUP_INTERVAL_SECONDS=0
