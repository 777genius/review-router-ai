+                f"      [10.1] Insert {len(links)} causal links: {time_mod.perf_counter() - insert_start:.3f}s"
+            )
+
+        return len(links)
+
+    except Exception as e:
+        logger.error(f"Failed to create causal links: {str(e)}")
+        import traceback
+
+        logging.getLogger(__name__).error("native_link_failed", exc_info=True)
